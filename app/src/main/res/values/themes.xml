<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Formula1" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/f1_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/f1_red</item>
        <item name="android:statusBarColor">@color/f1_carbon</item>
        <item name="android:navigationBarColor">@color/f1_carbon</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ThemeOverlay.Formula1.Toolbar" parent="ThemeOverlay.Material3">
        <item name="colorControlNormal">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
    </style>

    <style name="StatColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="StatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/f1_red</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="StatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/f1_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>